# URL database Dexie Cloud (didapat dari `npx dexie-cloud create`).
# Kosongkan untuk menjalankan aplikasi dalam MODE LOKAL (tanpa login & sinkron).
PUBLIC_DEXIE_CLOUD_URL=https://xxxxxxxx.dexie.cloud

# Server pesan mandiri (QR meja) — dipakai folder api/ (di Vercel isi lewat Environment Variables).
# Ambil client id & secret dari file dexie-cloud.key. JANGAN commit file .env yang berisi secret.
DEXIE_CLOUD_DB_URL=https://xxxxxxxx.dexie.cloud
DEXIE_CLOUD_CLIENT_ID=
DEXIE_CLOUD_CLIENT_SECRET=

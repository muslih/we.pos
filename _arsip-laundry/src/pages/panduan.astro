  <script>
    const nav = document.getElementById('nav')!;
    addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 8), { passive: true });
    if (localStorage.getItem('fw_session')) document.querySelectorAll<HTMLAnchorElement>('[data-auth]').forEach((a) => { a.href = 'app/'.replace(/^/, '../'); a.textContent = 'Buka Aplikasi'; });
    // Sorot bagian yang sedang dibaca
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-id]')];
    const secs = [...document.querySelectorAll<HTMLElement>('.gs')];
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('on', a.dataset.id === e.target.id));
      const chip = document.querySelector<HTMLElement>(`.tocbar a[data-id="${e.target.id}"]`);
      chip?.parentElement?.scrollTo({ left: chip.offsetLeft - 16, behavior: 'smooth' });
    }), { rootMargin: '-30% 0px -60% 0px' });
    secs.forEach((s) => io.observe(s));
    // Pencarian
    const q = document.getElementById('q') as HTMLInputElement, nores = document.getElementById('noresult')!;
    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase(); let n = 0;
      secs.forEach((s) => { const hit = !v || s.textContent!.toLowerCase().includes(v); s.hidden = !hit; if (hit) n++; });
      document.querySelector<HTMLElement>('.doc > .callout')!.hidden = !!v;
      nores.hidden = n > 0;
      if (v && n) document.querySelector('.gs:not([hidden])')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Umami: catat kata kunci setelah berhenti mengetik 1,2 dtk
      clearTimeout(qt);
      if (v.length >= 3) qt = setTimeout(() => (window as any).umami?.track('docs-cari', { kata: v.slice(0, 60), hasil: n }), 1200);
    });
    let qt: any;
  </script>


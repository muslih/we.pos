---
import { ClientRouter } from 'astro:transitions';
import Umami from '../components/Umami.astro';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '../styles/global.css';

interface Props { page: string; title: string; back?: boolean }
const { page, title, back = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f6f7fb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Fara Wash" />
    <meta name="description" content="Aplikasi kasir laundry" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}icons/icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <title>{title} · Fara Wash</title>
    <ClientRouter />
    <Umami />
  </head>
  <body data-page={page} data-back={back ? '1' : ''}>
    <div class="shell">
      <header>
        <img id="hLogo" class="logo" alt="" hidden />
        <div class="hl"><h1 id="title">{title}</h1><small id="hSub" hidden></small></div>
        <span id="hSync" class="sync" title="Status sinkron" hidden></span>
        <span id="hAct"></span>
      </header>
      <main id="main"><div class="loading">Memuat…</div></main>
      <div id="paybar"></div>
      <nav class="bn" id="nav"></nav>
    </div>
    <div class="sheet-bg" id="sheetBg"></div>
    <div class="sheet" id="sheet"></div>
    <div class="toast" id="toast"></div>
    <div id="print-area"></div>
    <div class="overlay" id="overlay" hidden></div>
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>

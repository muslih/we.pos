---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-600-italic.css';
import '../styles/site.css';
import Umami from '../components/Umami.astro';
interface Props { title: string; desc: string; page: 'home' | 'guide' }
const { title, desc, page } = Astro.props;
const base = import.meta.env.BASE_URL;
const logo = '<svg class="logo" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="7" fill="currentColor"/><path d="M9 10v5.5a3 3 0 0 0 3 3V23M12 10v4.5M15 10v5.5a3 3 0 0 1-3 3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22.5 23V9c-2 .8-3 3.5-3 7h3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const home = page === 'home' ? '' : base;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={`${base}img/pos.webp`} />
  <link rel="icon" type="image/png" href={`${base}icons/icon-192.png`} />
  <link rel="manifest" href={`${base}manifest.webmanifest`} />
  <Umami />
</head>
<body>
  <header class="nav" id="nav">
    <div class="wrap navin">
      <a class="brand" href={base}><Fragment set:html={logo} />We POS</a>
      <nav class="links">
        <a href={`${home}#alur`}>Cara kerja</a><a href={`${home}#aplikasi`}>Aplikasi</a><a href={`${home}#tim`}>Tim</a><a href={`${home}#harga`}>Harga</a><a href={`${home}#faq`}>FAQ</a><a href={`${base}panduan/`}>Panduan</a><a href={`${base}sop/`}>SOP</a>
      </nav>
      <div class="navbtn"><a class="btn ghost" href={`${base}app/`}>Masuk</a><a class="btn pri" href={`${base}app/?daftar`}>Coba gratis</a></div>
    </div>
  </header>
  <slot />
  <footer><div class="wrap foot">
    <a class="brand" href={base}><Fragment set:html={logo} />We POS</a>
    <nav><a href={`${base}#harga`}>Harga</a><a href={`${base}panduan/`}>Panduan</a><a href={`${base}sop/`}>SOP</a><a href={`${base}app/`}>Masuk</a><a href={`${base}app/?daftar`}>Daftar</a></nav>
    <span>© {new Date().getFullYear()} We POS · Kasir restoran yang simpel</span>
  </div></footer>
  <script is:inline>
    const n = document.getElementById('nav'); addEventListener('scroll', () => n.classList.toggle('scrolled', scrollY > 8), { passive: true });
  </script>
</body>
</html>

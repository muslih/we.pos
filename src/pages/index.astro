---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
const app = `${base}app/`;
const img = (n: string) => `${base}img/${n}.webp`;
const P: Record<string, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  pos: '<path d="M4 4h16v10H4zM8 18h8M12 14v4M7 8h4"/>',
  chef: '<path d="M7 14a4 4 0 0 1-.6-7.96A5 5 0 0 1 16 5a4 4 0 0 1 1 8v0M7 14v6h10v-7M7 17h10"/>',
  table: '<path d="M3 9h18M5 9v11M19 9v11M8 9V5h8v4"/>',
  cal: '<path d="M4 5h16v16H4zM4 10h16M9 3v4M15 3v4"/>',
  tv: '<path d="M3 5h18v12H3zM8 21h8M12 17v4"/>',
  chart: '<path d="M4 20V4M4 20h16M8 16v-4M12 16V8M16 16v-6"/>',
  cash: '<path d="M3 7h18v10H3z"/><circle cx="12" cy="12" r="2.5"/>',
  food: '<path d="M5 3v8a3 3 0 0 0 3 3v7M8 3v6M11 3v8a3 3 0 0 1-3 3M17 21V3c-2 1-3 4-3 8h3"/>',
  wifi: '<path d="M2 8.8a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 20h.01"/>',
  bell: '<path d="M6 16V10a6 6 0 0 1 12 0v6l2 2H4zM10 21h4"/>',
  sheet: '<path d="M4 3h16v18H4zM4 9h16M4 15h16M10 3v18"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  qr: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2M14 18h2M18 18h2v2M16 16h2v2"/>',
  print: '<path d="M7 8V3h10v5M7 17H4v-7h16v7h-3M7 14h10v7H7z"/>',
};
const XI = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>';
const ic = (k: string, s = 22) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${P[k]}</svg>`;
const apps = [
  ['pos', 'Kasir', 'Catat pesanan, pilih meja, kirim ke dapur atau langsung bayar. Kembalian terhitung sendiri.', 'Tablet · laptop · HP'],
  ['chef', 'Layar Dapur', 'Pesanan masuk sendiri, lengkap dengan bunyi dan penanda waktu. Koki tinggal ketuk “Selesai”.', 'Tablet dapur / bar'],
  ['table', 'Denah Meja', 'Lihat meja yang kosong, terisi, atau sudah dipesan. Tambah pesanan, pindah meja, cetak tagihan.', 'Kasir & pelayan'],
  ['cal', 'Reservasi', 'Catat tamu yang pesan lewat telepon atau WA, cek meja bentrok, kirim konfirmasi WhatsApp sekali ketuk.', 'Semua staf'],
  ['tv', 'Layar Antrian', 'Tampilkan nomor pesanan yang sedang disiapkan dan yang siap diambil di layar TV.', 'TV / tablet pelanggan'],
  ['cash', 'Tutup Kasir', 'Hitung uang di laci, lihat selisihnya, lalu cetak laporan akhir shift.', 'Kasir & pemilik'],
  ['chart', 'Laporan', 'Penjualan, jam ramai, menu terlaris, metode bayar, sampai laba kotor — tersusun sendiri.', 'Pemilik & manajer'],
  ['qr', 'Pesan Mandiri (QR)', 'Tamu scan QR di meja, pilih menu dari HP-nya, dan pesanan langsung sampai ke kasir & dapur.', 'Paket Pro ke atas'],
  ['print', 'Menu Meja Cetak', 'Cetak QR saja, QR plus menu, atau lembar pesanan untuk tiap meja. Ada 4 gaya, kertas A4/A5.', 'Semua paket'],
  ['qr', 'QRIS Dinamis', 'QRIS toko yang nominalnya sudah terisi sesuai tagihan. Tamu tinggal scan dan bayar.', 'Semua paket'],
  ['bell', 'Siap Diantar', 'Pelayan langsung tahu pesanan mana yang sudah siap, lalu menandainya setelah diantar.', 'HP pelayan'],
  ['sheet', 'Ekspor Excel', 'Unduh ke Excel atau CSV, atau salin ke Google Sheets untuk pembukuan.', 'Pemilik & manajer'],
];
const faqs = [
  ['Berapa harganya?', 'Paket Gratis Rp0 untuk selamanya, di 1 perangkat. Selama promo peluncuran, Pro Rp49.000, Bisnis Rp199.000, dan Korporat Rp299.000 per outlet per bulan (Korporat minimal 2 outlet). Bayar tahunan lebih hemat: Pro Rp490.000, Bisnis Rp2.000.000, dan Korporat Rp3.000.000 per outlet per tahun. Harga promo tetap berlaku selama Anda berlangganan.'],
  ['Apakah ada kontrak?', 'Tidak ada. Bayar bulanan atau tahunan, dan bisa berhenti kapan saja. Kalau berhenti, akun kembali ke paket Gratis dan data tetap bisa Anda simpan ke file.'],
  ['Kenapa QR meja tidak ada di paket Gratis?', 'Di paket Gratis, data hanya tersimpan di perangkat Anda, jadi HP tamu tidak bisa mengirim pesanan ke kasir. Pesan lewat QR butuh data yang tersimpan online, dan itu tersedia mulai paket Pro. Menu dan lembar pesanan kertas tetap bisa dicetak di paket Gratis.'],
  ['Bisa coba dulu?', 'Bisa. Pro dan Bisnis bisa dicoba gratis 14 hari tanpa kartu kredit. Paket Gratis sendiri bisa dipakai selamanya.'],
  ['Perlu install dari Play Store?', 'Tidak perlu. We POS dibuka lewat browser (Chrome, Safari, atau Edge) di HP, tablet, maupun laptop. Kalau ingin terasa seperti aplikasi biasa, pasang ke layar utama lewat menu “Tambahkan ke Layar Utama” atau “Install app”.'],
  ['Perangkat apa yang dibutuhkan?', 'Satu HP atau tablet sudah cukup untuk mulai. Kalau mulai ramai, tambahkan tablet untuk dapur dan TV atau tablet untuk layar antrian. Semua perangkat melihat data yang sama.'],
  ['Bagaimana staf masuk?', 'Pemilik menghubungkan perangkat sekali saja. Setelah itu, staf tinggal ketuk namanya dan masukkan PIN 4–6 angka. Mau ganti shift? Tekan “Kunci”.'],
  ['Kalau internet mati?', 'Tetap bisa jualan seperti biasa. Data tersimpan di perangkat dan tersinkron sendiri begitu internet kembali.'],
  ['Bisa cetak struk?', 'Bisa, ke printer thermal 58 mm atau 80 mm lewat menu cetak browser. Struk juga bisa dikirim ke WhatsApp tamu.'],
  ['Apakah ada pajak & service charge?', 'Ada. Atur persentase pajak (PB1) dan service di Pengaturan, lalu semuanya terhitung sendiri di setiap transaksi dan tercetak di struk.'],
  ['Kasir bisa membatalkan transaksi?', 'Bisa, tapi untuk item yang sudah masuk dapur atau transaksi yang sudah dibayar, perlu PIN Manajer atau Pemilik beserta alasannya. Semuanya tercatat.'],
];

/* ---------- Paket & harga ---------- */
const KONTAK = ''; // isi link WhatsApp/email untuk paket Korporat, mis. 'https://wa.me/62812xxxx'
type Plan = { k: string; name: string; tag: string; m: number; y: number; om?: number; oy?: number; unit: string; note: string; cta: string; href: string; hot?: boolean; feats: (string | [string, string])[] };
const plans: Plan[] = [
  { k: 'gratis', name: 'Gratis', tag: 'Untuk warung & usaha yang baru mulai', m: 0, y: 0, unit: 'selamanya', note: '1 perangkat · offline', cta: 'Mulai gratis', href: `${app}?daftar`,
    feats: ['Kasir, struk cetak & WhatsApp', 'Meja, layar dapur & antrian dalam 1 perangkat', 'Cetak menu & lembar pesanan per meja', 'Laporan harian & tutup kasir', 'Backup manual ke file', ['x', 'Data hanya tersimpan di perangkat ini'], ['x', 'Pesan lewat QR meja (mulai paket Pro)']] },
  { k: 'pro', name: 'Pro', tag: 'Untuk restoran & kafe yang mulai ramai', m: 49000, y: 490000, om: 79000, oy: 790000, unit: '/outlet/bulan', note: 'Coba gratis 14 hari', cta: 'Pilih paket', href: `${app}?daftar&paket=pro`, hot: true,
    feats: ['Semua fitur Gratis', 'Pakai di banyak perangkat: kasir, tablet dapur, HP pelayan', 'Staf tanpa batas, masing-masing dengan PIN', 'Data tersinkron online, tetap jalan saat offline', 'Tamu pesan sendiri lewat QR meja', 'Laporan semua periode & ekspor Excel', 'Reservasi + konfirmasi WhatsApp'] },
  { k: 'bisnis', name: 'Bisnis', tag: 'Untuk yang ingin keuangan lebih tertata', m: 199000, y: 2000000, om: 329000, oy: 3290000, unit: '/outlet/bulan', note: 'Coba gratis 14 hari', cta: 'Pilih paket', href: `${app}?daftar&paket=bisnis`,
    feats: ['Semua fitur Pro', 'Laporan laba-rugi & catatan pengeluaran', 'Penjualan per kasir', ['soon', 'Stok bahan & resep (HPP per menu)'], 'Dukungan prioritas lewat WhatsApp'] },
  { k: 'korporat', name: 'Korporat', tag: 'Untuk grup restoran & waralaba', m: 299000, y: 3000000, om: 499000, oy: 4990000, unit: '/outlet/bulan', note: 'Minimal 2 outlet', cta: 'Pilih paket', href: KONTAK || `${app}?daftar&paket=korporat`,
    feats: ['Semua fitur Bisnis', 'Harga khusus per outlet', ['soon', 'Laporan gabungan semua cabang'], 'Bantuan pindah data & pelatihan staf', 'Integrasi & kebutuhan khusus', 'Dukungan prioritas'] },
];
const rpx = (n: number) => 'Rp' + n.toLocaleString('id-ID');
/* Perbandingan fitur lengkap per paket — true ✓ · false – · 'soon' Segera · teks = keterangan. Urutan: Gratis, Pro, Bisnis, Korporat */
type V = boolean | 'soon' | string;
const Y = true, N = false, S = 'soon';
const compare: [string, string, [string, V, V, V, V, string?][]][] = [
  ['kasir', 'Kasir & pembayaran', [
    ['Kasir ketuk menu + catatan per item', Y, Y, Y, Y],
    ['Makan di tempat & bawa pulang', Y, Y, Y, Y],
    ['Diskon persen / nominal', Y, Y, Y, Y],
    ['Pajak (PB1) & service charge otomatis', Y, Y, Y, Y],
    ['Tunai, QRIS, transfer & kartu', Y, Y, Y, Y],
    ['Nominal cepat & hitung kembalian', Y, Y, Y, Y],
    ['QRIS dinamis (nominal terisi otomatis)', Y, Y, Y, Y, 'Ubah QRIS statis toko jadi QR bernominal saat bayar'],
    ['Tagihan terbuka & tambah pesanan', Y, Y, Y, Y],
    ['Struk cetak 58 / 80 mm', Y, Y, Y, Y],
    ['Struk via WhatsApp', Y, Y, Y, Y],
    ['Pembatalan dengan PIN manajer', Y, Y, Y, Y],
    ['Split bill', N, S, S, S],
  ]],
  ['layanan', 'Meja, dapur & layanan', [
    ['Denah & status meja', Y, Y, Y, Y],
    ['Layar dapur (KDS) dengan bunyi', 'Di perangkat yang sama', 'Tablet terpisah', 'Tablet terpisah', 'Tablet terpisah'],
    ['Pisah stasiun dapur & bar', Y, Y, Y, Y],
    ['Daftar siap diantar untuk pelayan', Y, Y, Y, Y],
    ['HP pelayan untuk catat pesanan', N, Y, Y, Y],
    ['Layar antrian nomor pesanan', Y, Y, Y, Y],
    ['Reservasi + konfirmasi WhatsApp', N, Y, Y, Y],
  ]],
  ['mandiri', 'Pesan mandiri (self service)', [
    ['Cetak menu & lembar pesanan per meja', Y, Y, Y, Y],
    ['4 gaya menu cetak (A4 / A5)', Y, Y, Y, Y],
    ['QR meja: pelanggan pesan dari HP', N, Y, Y, Y, 'Butuh database online — paket Gratis menyimpan data di perangkat saja'],
    ['Kartu QR 1 / 2 / 4 / 6 per halaman', N, Y, Y, Y],
    ['Pesanan QR langsung ke kasir & dapur', N, Y, Y, Y],
    ['Pilihan konfirmasi kasir dulu', N, Y, Y, Y, 'Kasir memeriksa pesanan QR sebelum masuk dapur'],
    ['Pelanggan pantau status pesanan', N, Y, Y, Y],
  ]],
  ['menu', 'Menu & stok', [
    ['Menu & kategori tak terbatas + foto', Y, Y, Y, Y],
    ['Tandai menu habis', Y, Y, Y, Y],
    ['Varian & topping', S, S, S, S],
    ['Stok bahan & resep (HPP per menu)', N, N, S, S],
  ]],
  ['laporan', 'Laporan & keuangan', [
    ['Ringkasan penjualan & tutup kasir', Y, Y, Y, Y],
    ['Periode laporan', 'Harian', 'Semua periode', 'Semua periode', 'Semua periode'],
    ['Menu terlaris & jam ramai', Y, Y, Y, Y],
    ['Catat pengeluaran', N, N, Y, Y],
    ['Laba-rugi', N, N, Y, Y],
    ['Penjualan per kasir', N, N, Y, Y],
    ['Ekspor Excel, CSV & Google Sheets', N, Y, Y, Y],
    ['Laporan gabungan semua cabang', N, N, N, S],
  ]],
  ['tim', 'Tim & keamanan', [
    ['Akun staf dengan PIN', 'Tak terbatas', 'Tak terbatas', 'Tak terbatas', 'Tak terbatas'],
    ['5 peran & hak akses', Y, Y, Y, Y, 'Pemilik, Manajer, Kasir, Pelayan, Dapur'],
    ['Ganti shift cepat (ketuk nama + PIN)', Y, Y, Y, Y],
    ['Kode pemulihan akun', Y, Y, Y, Y],
    ['Putuskan perangkat hilang dari jauh', N, Y, Y, Y],
  ]],
  ['perangkat', 'Perangkat & data', [
    ['Jumlah perangkat', '1', 'Tak terbatas', 'Tak terbatas', 'Tak terbatas'],
    ['HP, tablet & laptop (tanpa Play Store)', Y, Y, Y, Y],
    ['Tetap jalan saat offline', Y, Y, Y, Y],
    ['Sinkron online antar perangkat', N, Y, Y, Y],
    ['Data aman di cloud', N, Y, Y, Y],
    ['Backup & pulihkan ke file', Y, Y, Y, Y],
    ['Tema warna toko & logo di struk', Y, Y, Y, Y],
  ]],
  ['bantuan', 'Bantuan & layanan', [
    ['Panduan & SOP restoran', Y, Y, Y, Y],
    ['Coba gratis 14 hari', '–', Y, Y, Y],
    ['Dukungan', 'Panduan', 'WhatsApp', 'Prioritas', 'Prioritas'],
    ['Bantuan pindah data & pelatihan staf', N, N, N, Y],

---
// Halaman pesan mandiri untuk pelanggan (dibuka dari QR di meja). Tidak memakai Dexie: data lewat /api/*.
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="robots" content="noindex" />
  <title>Pesan dari meja</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="icon" type="image/png" href={`${base}icons/icon-192.png`} />
  <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
  <style is:global>
    :root { --pri: #ea580c; --on-pri: #fff; --pri-l: color-mix(in srgb, var(--pri) 10%, white); --pri-tx: color-mix(in srgb, var(--pri) 70%, black);
      --bg: #f4f5f6; --card: #fff; --tx: #18191b; --tx2: #4d5157; --mut: #858a91; --line: #e3e5e8; --ok: #18864b; --ok-l: #e3f4ea; --warn: #b26a00; --warn-l: #fdf1dc; --err: #d03a2b;
      --rad-btn: 8px; --rad-btn2: 6px; --rad-card: 6px; --rad-modal: 8px; --rad-badge: 4px; --safe-b: env(safe-area-inset-bottom, 0px);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--tx); background: var(--bg); -webkit-tap-highlight-color: transparent; }
    * { box-sizing: border-box; } body { margin: 0; font-size: 15px; line-height: 1.4; padding-bottom: 96px; }
    button, input, textarea { font: inherit; color: inherit; } button { cursor: pointer; border: 0; background: none; padding: 0; }
    svg { width: 20px; height: 20px; }
    .top { position: sticky; top: 0; z-index: 5; background: var(--card); border-bottom: 1px solid var(--line); }
    .head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; max-width: 720px; margin: 0 auto; }
    .head img { width: 42px; height: 42px; border-radius: 6px; object-fit: cover; }
    .head .t { flex: 1; min-width: 0; } .head b { display: block; font-size: 17px; } .head small { color: var(--mut); }
    .tbl { background: var(--pri); color: var(--on-pri); border-radius: var(--rad-btn2); padding: 6px 12px; text-align: center; line-height: 1.1; }
    .tbl small { display: block; font-size: 10px; letter-spacing: .12em; color: inherit; opacity: .85; } .tbl b { font-size: 20px; }
    .cats { display: flex; gap: 8px; overflow-x: auto; padding: 0 16px 12px; max-width: 720px; margin: 0 auto; scrollbar-width: none; }
    .cats::-webkit-scrollbar { display: none; }
    .chip { flex: none; height: 36px; padding: 0 14px; border-radius: var(--rad-btn2); border: 1px solid var(--line); background: var(--card); font-weight: 600; font-size: 14px; color: var(--tx2); }
    .chip.on { background: var(--pri); border-color: var(--pri); color: var(--on-pri); }
    main { max-width: 720px; margin: 0 auto; padding: 12px 16px; }
    .sec { font-size: 13px; font-weight: 700; color: var(--tx2); text-transform: uppercase; letter-spacing: .06em; margin: 18px 2px 8px; scroll-margin-top: 130px; }
    .items { background: var(--card); border: 1px solid var(--line); border-radius: var(--rad-card); overflow: hidden; }
    .it { display: flex; align-items: center; gap: 12px; padding: 12px; border-bottom: 1px solid var(--line); }
    .it:last-child { border-bottom: 0; }
    .pic { width: 64px; height: 64px; border-radius: 6px; background: #eef0f2; display: grid; place-items: center; overflow: hidden; flex: none; font-size: 32px; }
    .pic img { width: 100%; height: 100%; object-fit: cover; }
    .it .m { flex: 1; min-width: 0; } .it .m b { display: block; font-weight: 600; } .it .m span { color: var(--pri-tx); font-weight: 700; }
    .it.off { opacity: .5; } .it.off .m span { color: var(--err); }
    .add { height: 38px; padding: 0 16px; border-radius: var(--rad-btn); background: var(--pri); color: var(--on-pri); font-weight: 700; }
    .step { display: flex; align-items: center; border: 1px solid var(--line); border-radius: var(--rad-btn2); }
    .step button { width: 38px; height: 38px; display: grid; place-items: center; font-size: 20px; font-weight: 700; color: var(--pri-tx); }
    .step span { min-width: 24px; text-align: center; font-weight: 700; }
    .bar { position: fixed; left: 12px; right: 12px; bottom: calc(12px + var(--safe-b)); max-width: 696px; margin: 0 auto; height: 58px; border-radius: var(--rad-btn); background: var(--pri); color: var(--on-pri);
      display: flex; align-items: center; gap: 12px; padding: 0 18px; font-weight: 700; box-shadow: 0 12px 30px -12px rgba(0,0,0,.4); z-index: 6; }
    .bar .n { background: color-mix(in srgb, var(--on-pri) 22%, transparent); border-radius: var(--rad-badge); padding: 2px 9px; }
    .bar .s { flex: 1; text-align: left; } .bar b { font-size: 17px; }
    .bar.ghost { background: var(--tx); color: #fff; }
    .bg { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9; }
    .sheet { position: fixed; left: 0; right: 0; bottom: 0; max-height: 90dvh; overflow: auto; background: var(--card); border-radius: var(--rad-modal) var(--rad-modal) 0 0; z-index: 10; padding: 18px 16px calc(18px + var(--safe-b)); max-width: 720px; margin: 0 auto; }
    .sheet h2 { margin: 0 0 12px; font-size: 20px; display: flex; justify-content: space-between; align-items: center; }
    .x { width: 36px; height: 36px; border-radius: var(--rad-btn2); background: #eef0f2; display: grid; place-items: center; }
    .cl { padding: 10px 0; border-bottom: 1px dashed var(--line); }
    .cl .r1 { display: flex; align-items: center; gap: 10px; } .cl .r1 .m { flex: 1; } .cl .r1 b { display: block; }
    .cl input { margin-top: 8px; }
    input, textarea { width: 100%; height: 44px; border: 1px solid var(--line); border-radius: 6px; padding: 0 12px; background: #fff; outline: none; font-size: 15px; }
    textarea { height: 64px; padding: 10px 12px; resize: none; }
    input:focus, textarea:focus { border-color: var(--pri); box-shadow: 0 0 0 3px var(--pri-l); }
    label.fl { display: block; margin-top: 12px; } label.fl span { display: block; font-size: 13px; font-weight: 600; color: var(--tx2); margin-bottom: 6px; }
    .sum { margin-top: 14px; font-size: 14px; } .sum div { display: flex; justify-content: space-between; padding: 3px 0; color: var(--tx2); }
    .sum .tot { font-size: 19px; font-weight: 800; color: var(--tx); }
    .btn { display: flex; width: 100%; height: 54px; align-items: center; justify-content: center; gap: 8px; border-radius: var(--rad-btn); background: var(--pri); color: var(--on-pri); font-weight: 700; font-size: 16px; margin-top: 14px; }
    .btn:disabled { opacity: .5; } .btn.sec { background: var(--pri-l); color: var(--pri-tx); }
    .note { color: var(--mut); font-size: 13px; text-align: center; margin: 10px 0 0; }
    .err { background: #fbe7e4; color: #8f2318; border-radius: 6px; padding: 10px 12px; margin-top: 12px; font-size: 14px; }
    .center { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; gap: 8px; }
    .center p { color: var(--mut); margin: 0; max-width: 340px; }
    .spin { width: 30px; height: 30px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--pri); animation: s .8s linear infinite; } @keyframes s { to { transform: rotate(360deg); } }
    .ok-ico { width: 72px; height: 72px; border-radius: 50%; background: var(--ok-l); color: var(--ok); display: grid; place-items: center; } .ok-ico svg { width: 38px; height: 38px; }
    .status { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--line); border-radius: var(--rad-card); margin-top: 14px; text-align: left; }
    .status div { display: flex; justify-content: space-between; gap: 10px; padding: 11px 14px; border-bottom: 1px solid var(--line); } .status div:last-child { border-bottom: 0; }
    .st { font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: var(--rad-badge); white-space: nowrap; background: #eef0f2; color: var(--tx2); }
    .st.new { background: var(--warn-l); color: var(--warn); } .st.cook { background: #e6f0f9; color: #2d6aa3; } .st.ready { background: var(--ok); color: #fff; } .st.served { background: var(--ok-l); color: var(--ok); }
    .recent { display: block; width: 100%; text-align: left; background: var(--ok-l); color: var(--ok); border-radius: var(--rad-card); padding: 10px 12px; font-weight: 600; margin-bottom: 4px; }
  </style>
</head>
<body>
  <div id="app"><div class="center"><div class="spin"></div><p>Memuat menu…</p></div></div>
  <script>
    const API = import.meta.env.BASE_URL + 'api/';
    const q = new URLSearchParams(location.search);
    const R = q.get('r') || '', T = q.get('t') || '', K = q.get('k') || '';
    const LS = `wp_self_${R}_${T}`;
    const $ = (s: string) => document.querySelector(s) as any;
    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);
    const rp = (n: number) => 'Rp ' + Math.round(n || 0).toLocaleString('id-ID');
    const pad = (n: number) => String(n).padStart(2, '0');
    const today = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
    const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const ST: Record<string, string> = { new: 'Menunggu konfirmasi', cook: 'Sedang dimasak', ready: 'Siap diantar', served: 'Sudah diantar' };
    let M: any = null; const cart: Record<string, { qty: number; note: string }> = {}; let cat = 'all', busy = false, poll: any = 0;

    function lum(hex: string) { const n = hex.replace('#', ''); return [0, 2, 4].map((i) => { const v = parseInt(n.slice(i, i + 2), 16) / 255; return v <= .03928 ? v / 12.92 : Math.pow((v + .055) / 1.055, 2.4); }).reduce((a, v, i) => a + v * [.2126, .7152, .0722][i], 0); }
    function theme(c: string) { if (!/^#[0-9a-f]{6}$/i.test(c)) return; document.documentElement.style.setProperty('--pri', c); document.documentElement.style.setProperty('--on-pri', 1.05 / (lum(c) + .05) >= 3 ? '#fff' : '#18191b'); }
    async function api(path: string, opt?: RequestInit) {
      let r: Response; try { r = await fetch(API + path, opt); } catch { throw new Error('Tidak ada koneksi internet. Coba lagi.'); }
      let j: any = {}; try { j = await r.json(); } catch { if (!r.ok) throw new Error(r.status === 404 ? 'Layanan pesan belum tersedia di alamat ini.' : 'Server sedang bermasalah (' + r.status + ').'); }
      if (!r.ok) throw new Error(j.error || 'Gagal (' + r.status + ')'); return j;
    }
    const fail = (msg: string) => { $('#app').innerHTML = `<div class="center"><b style="font-size:18px">Maaf 🙏</b><p>${esc(msg)}</p><p>Silakan pesan langsung ke kasir atau pelayan.</p><button class="btn sec" style="max-width:240px" onclick="location.reload()">Coba lagi</button></div>`; };
    const count = () => Object.values(cart).reduce((a, c) => a + c.qty, 0);
    const subtotal = () => Object.entries(cart).reduce((a, [id, c]) => a + (M.items.find((i: any) => i.id === id)?.price || 0) * c.qty, 0);
    const recent = () => { try { const x = JSON.parse(localStorage.getItem(LS) || 'null'); return x && Date.now() - x.at < 4 * 3600e3 ? x : null; } catch { return null; } };

    function render() {
      const r = M.resto, groups = [...M.categories, { id: '', name: 'Lainnya', icon: '' }]
        .map((c: any) => ({ c, items: M.items.filter((i: any) => (c.id ? i.categoryId === c.id : !M.categories.some((x: any) => x.id === i.categoryId))) })).filter((g: any) => g.items.length);
      const rc = recent();
      $('#app').innerHTML = `<div class="top"><div class="head">${r.logo ? `<img src="${r.logo}" alt="">` : ''}<div class="t"><b>${esc(r.name)}</b><small>Pilih menu, lalu kirim pesanan</small></div>
         ${M.table ? `<div class="tbl"><small>MEJA</small><b>${esc(M.table.name)}</b></div>` : ''}</div>
        <div class="cats"><button class="chip ${cat === 'all' ? 'on' : ''}" data-cat="all">Semua</button>${groups.map((g: any) => `<button class="chip ${cat === g.c.id ? 'on' : ''}" data-cat="${g.c.id}">${g.c.icon ? g.c.icon + ' ' : ''}${esc(g.c.name)}</button>`).join('')}</div></div>
       <main>${rc ? `<button class="recent" id="seeRecent">✓ Pesanan #${rc.no} terkirim — lihat status</button>` : ''}
        ${groups.map((g: any) => `<div class="sec" id="c_${g.c.id || 'x'}">${g.c.icon ? g.c.icon + ' ' : ''}${esc(g.c.name)}</div><div class="items">${g.items.map(itemRow).join('')}</div>`).join('')}</main>
       <div id="barWrap"></div>`;
      bar();
      document.querySelectorAll('[data-cat]').forEach((b: any) => (b.onclick = () => { cat = b.dataset.cat; document.querySelectorAll('[data-cat]').forEach((x: any) => x.classList.toggle('on', x === b));
        const el = cat === 'all' ? null : document.getElementById('c_' + cat); el ? el.scrollIntoView({ behavior: 'smooth' }) : scrollTo({ top: 0, behavior: 'smooth' }); }));
      $('#seeRecent')?.addEventListener('click', () => statusView(rc));
      bindItems();
    }
    function itemRow(i: any) {
      const c = cart[i.id];
      return `<div class="it ${i.available ? '' : 'off'}" data-id="${i.id}"><div class="pic">${i.photo ? `<img src="${i.photo}" alt="" loading="lazy">` : i.icon || '🍽️'}</div>
        <div class="m"><b>${esc(i.name)}</b><span>${i.available ? rp(i.price) : 'Habis'}</span></div>
        ${!i.available ? '' : c ? `<div class="step"><button data-d="-1" aria-label="Kurangi">−</button><span>${c.qty}</span><button data-d="1" aria-label="Tambah">+</button></div>` : `<button class="add" data-d="1">Tambah</button>`}</div>`;
    }
    function bindItems() {
      document.querySelectorAll('.it').forEach((row: any) => row.querySelectorAll('[data-d]').forEach((b: any) => (b.onclick = () => {
        const id = row.dataset.id; change(id, +b.dataset.d);
        row.outerHTML = itemRow(M.items.find((i: any) => i.id === id)); bindItems(); bar();
      })));
    }
    function change(id: string, d: number) { const c = cart[id] || { qty: 0, note: '' }; c.qty += d; if (c.qty <= 0) delete cart[id]; else cart[id] = c; }
    function bar() {
      const n = count(), w = $('#barWrap'); if (!w) return;
      w.innerHTML = n ? `<button class="bar" id="openCart"><span class="n">${n}</span><span class="s">Lihat pesanan</span><b>${rp(subtotal())}</b></button>` : '';
      $('#openCart')?.addEventListener('click', cartSheet);
    }
    function totals() {
      const sub = subtotal(), r = M.resto, svc = Math.round(sub * (r.servicePct || 0) / 100), tax = Math.round((sub + svc) * (r.taxPct || 0) / 100);
      return { sub, svc, tax, total: sub + svc + tax };
    }
    function cartSheet() {
      const t = totals(), r = M.resto;
      const lines = Object.entries(cart).map(([id, c]) => { const i = M.items.find((x: any) => x.id === id); return `<div class="cl" data-id="${id}"><div class="r1"><div class="m"><b>${esc(i.name)}</b><small>${rp(i.price)}</small></div>
        <div class="step"><button data-d="-1">−</button><span>${c.qty}</span><button data-d="1">+</button></div></div>
        <input data-note placeholder="Catatan (mis. tidak pedas)" maxlength="120" value="${esc(c.note)}"></div>`; }).join('');
      document.body.insertAdjacentHTML('beforeend', `<div class="bg" id="bg"></div><div class="sheet" id="sh"><h2>Pesanan Anda<button class="x" id="shx" aria-label="Tutup">✕</button></h2>${lines}
        <label class="fl"><span>Nama Anda (opsional)</span><input id="guest" maxlength="40" value="${esc(localStorage.getItem('wp_self_name') || '')}" placeholder="Agar mudah dipanggil"></label>
        <label class="fl"><span>Catatan untuk restoran (opsional)</span><textarea id="onote" maxlength="160" placeholder="mis. minta sendok tambahan"></textarea></label>
        <div class="sum"><div><span>Subtotal</span><span>${rp(t.sub)}</span></div>${t.svc ? `<div><span>Service ${r.servicePct}%</span><span>${rp(t.svc)}</span></div>` : ''}${t.tax ? `<div><span>Pajak ${r.taxPct}%</span><span>${rp(t.tax)}</span></div>` : ''}
         <div class="tot"><span>Total</span><span>${rp(t.total)}</span></div></div>
        <div id="sendErr"></div><button class="btn" id="send">Kirim pesanan ${M.table ? 'ke Meja ' + esc(M.table.name) : ''}</button>
        <p class="note">Pembayaran dilakukan di kasir setelah selesai makan.</p></div>`);
      const close = () => { $('#bg')?.remove(); $('#sh')?.remove(); };
      $('#bg').onclick = close; $('#shx').onclick = close;
      $('#sh').querySelectorAll('.cl').forEach((row: any) => {
        row.querySelectorAll('[data-d]').forEach((b: any) => (b.onclick = () => { change(row.dataset.id, +b.dataset.d); close(); render(); if (count()) cartSheet(); }));
        row.querySelector('[data-note]').oninput = (e: any) => { if (cart[row.dataset.id]) cart[row.dataset.id].note = e.target.value; };
      });
      $('#send').onclick = send;
    }
    async function send() {
      if (busy || !count()) return; busy = true;
      const b = $('#send'); b.disabled = true; b.textContent = 'Mengirim…'; $('#sendErr').innerHTML = '';
      const guest = $('#guest').value.trim(); localStorage.setItem('wp_self_name', guest);
      try {
        const j = await api('order', { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ r: R, k: K, t: T, guest, note: $('#onote').value.trim(), day: today(), lines: Object.entries(cart).map(([itemId, c]) => ({ itemId, qty: c.qty, note: c.note })) }) });
        Object.keys(cart).forEach((k) => delete cart[k]);
        const rec = { orderId: j.orderId, no: j.no, at: Date.now() }; localStorage.setItem(LS, JSON.stringify(rec));
        $('#bg')?.remove(); $('#sh')?.remove(); statusView(rec, j.pending);
      } catch (e: any) { $('#sendErr').innerHTML = `<div class="err">${esc(e.message)}</div>`; b.disabled = false; b.textContent = 'Coba kirim lagi'; }
      busy = false;
    }
    async function statusView(rec: any, pending?: boolean) {
      clearTimeout(poll); scrollTo({ top: 0 });
      $('#app').innerHTML = `<div class="center"><div class="ok-ico">${CHECK}</div><b style="font-size:21px">Pesanan #${rec.no} terkirim</b>
        <p id="stMsg">${pending ? 'Menunggu konfirmasi kasir…' : 'Pesanan sudah masuk ke dapur.'} Silakan tunggu di meja ${M?.table ? esc(M.table.name) : ''}.</p>
        <div class="status" id="stList"></div><button class="btn sec" style="max-width:420px" id="again">Pesan lagi</button><p class="note">Pembayaran di kasir · halaman ini diperbarui otomatis</p></div>`;
      $('#again').onclick = () => { clearTimeout(poll); render(); scrollTo({ top: 0 }); };
      const tick = async () => {
        try {
          const s = await api(`status?r=${encodeURIComponent(R)}&k=${encodeURIComponent(K)}&o=${encodeURIComponent(rec.orderId)}`);
          const el = $('#stList'); if (!el) return;
          el.innerHTML = s.lines.map((l: any) => `<div><span>${l.qty}× ${esc(l.name)}</span><span class="st ${l.status}">${ST[l.status] || ''}</span></div>`).join('') || '<div><span>Pesanan dibatalkan kasir</span></div>';
          $('#stMsg').textContent = s.status === 'paid' ? 'Terima kasih! Pesanan sudah dibayar.' : s.status === 'void' ? 'Pesanan dibatalkan. Silakan hubungi kasir.' : s.pending ? 'Menunggu konfirmasi kasir…' : s.lines.every((l: any) => l.status === 'served') ? 'Selamat menikmati! 🍽️' : 'Pesanan sedang disiapkan dapur.';
          if (s.status === 'open') poll = setTimeout(tick, 10000);
        } catch { poll = setTimeout(tick, 15000); }
      };
      tick();
    }
    (async () => {
      if (!R || !K) return fail('QR tidak lengkap. Scan ulang QR yang ada di meja.');
      try { M = await api(`menu?r=${encodeURIComponent(R)}&k=${encodeURIComponent(K)}&t=${encodeURIComponent(T)}`); }
      catch (e: any) { return fail(e.message); }
      theme(M.resto.color); document.title = M.resto.name + (M.table ? ' · Meja ' + M.table.name : '');
      render();
    })();
  </script>
</body>
</html>
